<!--
  Launcher foreground.

  The adaptive icon safe zone is the middle 66dp of 108dp, because a launcher
  may mask the icon to any shape. The mark is drawn on its own 100 by 100 grid
  and placed inside that zone by a single scale and translate, so the geometry
  stays identical to every other copy of the mark rather than being redrawn to
  fit.

  Scale 0.68 puts the mark's 76 by 69 bounding box at roughly 52 by 47, which
  clears the safe zone on every side. The translate is 54 minus 50 times the
  scale, which is what centres the grid's midpoint on the icon's.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.68" android:scaleY="0.68"
        android:translateX="20" android:translateY="20">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 50.00 84.54 C 44.86 61.83 40.66 42.72 40.66 24.79 C 40.66 19.66 44.86 15.46 50.00 15.46 C 55.13 15.46 59.33 19.66 59.33 24.79 C 59.33 42.72 55.13 61.83 50.00 84.54Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 43.77 81.22 C 31.35 68.74 20.98 58.17 14.26 46.53 C 12.00 42.62 13.35 37.57 17.27 35.31 C 21.18 33.05 26.23 34.40 28.49 38.31 C 35.21 49.96 39.17 64.22 43.77 81.22Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M 56.22 81.22 C 60.82 64.22 64.79 49.96 71.51 38.31 C 73.77 34.40 78.82 33.05 82.73 35.31 C 86.64 37.57 88.00 42.62 85.74 46.53 C 79.02 58.17 68.65 68.74 56.22 81.22Z" />
    </group>
</vector>
