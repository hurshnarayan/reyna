<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 and later block plaintext HTTP by default, which is the right
  default: an app talking to a service it does not control should not be
  sending user content unencrypted.

  Reyna is self-hosted. The backend runs on the user's own laptop or a box on
  their own network, its address is typed into the Settings screen, and it is
  almost always plain http on a private address. That address cannot be known
  when the app is built, so it cannot be enumerated here. An earlier version of
  this file tried to, by listing 192.168.0.0 and friends as domains, which does
  not work: these entries are matched as hostnames, not as CIDR ranges, so a
  backend at 192.168.0.15 matched nothing and every call failed with
  "CLEARTEXT communication not permitted" while the app reported it as an
  unreachable server.

  So cleartext is permitted. What limits the exposure is not this file but the
  fact that the user chooses the address themselves and it is their own machine
  on their own network. Once Reyna ships a hosted backend, this should become a
  domain-config pinned to that host with cleartext refused everywhere else.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
