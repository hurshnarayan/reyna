# Reyna — Environment Configuration
# Copy this to .env and fill in your values: cp .env.example .env

# ── Server ──
PORT=8080
DATABASE_URL=./reyna.db
JWT_SECRET=change-this-to-a-random-secret-in-production
FRONTEND_URL=http://localhost:5173

# ── Device token ──
# Shared secret between the backend and the WhatsApp bot (and later the Android
# app). The /api/bot/* and /api/nlp/* routes accept file uploads and expose group
# contents, so they are not open. Both processes must see the same value.
# Generate one with: openssl rand -hex 32
# If you leave this blank the backend generates a temporary one and prints it at
# startup, but it changes on every restart and the bot will not authenticate.
DEVICE_TOKEN=

# ── Google Drive ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# ── LLM Provider ──
# Pick one. Set the key for whichever provider you want to use.
# If LLM_PROVIDER is left empty, reyna auto-detects from whichever key is set.
LLM_PROVIDER=gemini

# Gemini (default, recommended) -- get a free key at aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude (Anthropic) -- console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI -- platform.openai.com/api-keys
OPENAI_API_KEY=

# Grok (xAI) -- console.x.ai
XAI_API_KEY=

# ── Auto-Commit ──
# Hours before staged files auto-commit to drive (default 24)
AUTO_COMMIT_HOURS=24
