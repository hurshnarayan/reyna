#!/usr/bin/env python3
"""
reyna-find: Raycast-style instant fuzzy document retrieval for WhatsApp documents captured by Reyna.
Powered by fzf, SQLite, and WSL Windows clipboard integration.
"""

import sys
import os
import sqlite3
import subprocess
import shutil
from pathlib import Path

# Paths
SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
DB_PATH = REPO_ROOT / "reyna.db"
RAW_STORAGE = REPO_ROOT / "drive_storage" / "_raw"
FILES_DIR = REPO_ROOT / "drive_storage" / "files"

# Colors for ANSI output
BOLD = "\033[1m"
DIM = "\033[2m"
ITALIC = "\033[3m"
RESET = "\033[0m"
GREEN = "\033[38;5;42m"
CYAN = "\033[38;5;45m"
YELLOW = "\033[38;5;220m"
MAGENTA = "\033[38;5;177m"
BLUE = "\033[38;5;75m"
GRAY = "\033[38;5;244m"
WHITE = "\033[38;5;255m"
BG_DARK = "\033[48;5;235m"

def format_size(bytes_num):
    if not bytes_num:
        return "0 B"
    for unit in ['B', 'KB', 'MB', 'GB']:
        if bytes_num < 1024:
            return f"{bytes_num:.1f} {unit}" if unit != 'B' else f"{bytes_num} B"
        bytes_num /= 1024
    return f"{bytes_num:.1f} TB"

def get_windows_path(linux_path: Path) -> str:
    try:
        res = subprocess.run(["wslpath", "-w", str(linux_path)], capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        # Fallback manual calculation
        abs_p = str(linux_path.resolve())
        return "\\\\wsl.localhost\\Ubuntu" + abs_p.replace("/", "\\")

def copy_to_clipboard(text: str):
    # Try clip.exe for Windows
    try:
        p = subprocess.Popen(["clip.exe"], stdin=subprocess.PIPE)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass
    # Also try wl-copy or xclip if available in Linux GUI
    for tool in [["wl-copy"], ["xclip", "-selection", "clipboard"]]:
        if shutil.which(tool[0]):
            try:
                p = subprocess.Popen(tool, stdin=subprocess.PIPE)
                p.communicate(input=text.encode("utf-8"))
            except Exception:
                pass

def sync_local_files():
    FILES_DIR.mkdir(parents=True, exist_ok=True)
    if not DB_PATH.exists():
        return
    try:
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        c.execute("SELECT id, file_name FROM files")
        for file_id, file_name in c.fetchall():
            if not file_name:
                continue
            raw_path = RAW_STORAGE / str(file_id)
            target_path = FILES_DIR / file_name
            if raw_path.exists() and not target_path.exists():
                try:
                    # Attempt hardlink first (fast, 0 storage)
                    os.link(raw_path, target_path)
                except Exception:
                    try:
                        shutil.copy2(raw_path, target_path)
                    except Exception:
                        pass
        conn.close()
    except Exception:
        pass

def render_preview(file_id_str: str):
    if not file_id_str or not file_id_str.isdigit():
        print(f"{GRAY}Select a document on the left to preview...{RESET}")
        return

    file_id = int(file_id_str)
    if not DB_PATH.exists():
        print(f"{YELLOW}Reyna database not found at {DB_PATH}{RESET}")
        return

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT id, file_name, subject, shared_by_name, shared_by_phone,
               file_size, mime_type, drive_file_id, status, created_at,
               content_summary, extracted_content
        FROM files WHERE id = ?
    """, (file_id,))
    row = c.fetchone()
    conn.close()

    if not row:
        print(f"{YELLOW}Document ID {file_id} not found.{RESET}")
        return

    (fid, name, subject, sender_name, sender_phone,
     size, mime, drive_id, status, created_at,
     summary, content) = row

    local_path = FILES_DIR / (name or f"file_{fid}")
    win_path = get_windows_path(local_path)
    drive_url = f"https://drive.google.com/file/d/{drive_id}/view" if (drive_id and not drive_id.startswith("local_")) else ""

    # Banner
    print(f"{GREEN}{BOLD}╭──────────────────────────────────────────────────────────╮{RESET}")
    print(f"{GREEN}{BOLD}│  REYNA // INSTANT DOCUMENT RETRIEVAL                     │{RESET}")
    print(f"{GREEN}{BOLD}╰──────────────────────────────────────────────────────────╯{RESET}")
    print()

    # Title & Metadata
    print(f"  {WHITE}{BOLD}{name}{RESET}")
    badge = f"{BG_DARK}{GREEN} {subject or 'Uncategorized'} {RESET}"
    type_badge = f"{BG_DARK}{CYAN} {mime or 'document'} {RESET}"
    size_str = f"{GRAY}{format_size(size)}{RESET}"
    print(f"  {badge}  {type_badge}  {size_str}")
    print()

    # Sender & Timeline
    sender = sender_name or sender_phone or "Unknown sender"
    if sender_phone and sender_name and sender_name != sender_phone:
        sender += f" ({sender_phone})"
    print(f"  {BOLD}Shared by:{RESET}  {WHITE}{sender}{RESET}")
    print(f"  {BOLD}Captured:{RESET}   {GRAY}{created_at}{RESET}")
    print(f"  {BOLD}Status:{RESET}     {GREEN if status == 'committed' else YELLOW}{status}{RESET}")
    print()

    # Google Drive Link
    if drive_url:
        print(f"  {BOLD}Google Drive:{RESET} {CYAN}{drive_url}{RESET}")
    else:
        print(f"  {BOLD}Google Drive:{RESET} {GRAY}Stored locally on machine{RESET}")

    # Local Path
    print(f"  {BOLD}Windows Path:{RESET} {DIM}{win_path}{RESET}")
    print()

    # Separator
    print(f"{GRAY}────────────────────────────────────────────────────────────{RESET}")

    # AI Summary
    print(f"{YELLOW}{BOLD}AI CONTENT SUMMARY{RESET}")
    if summary and summary.strip():
        # Clean markdown wrappers if any
        clean_summary = summary.strip().replace("```markdown", "").replace("```json", "").replace("```", "").strip()
        for line in clean_summary.splitlines():
            print(f"  {WHITE}{line}{RESET}")
    else:
        print(f"  {GRAY}(no ai summary generated yet for this file){RESET}")
    print()

    # Text / Document Extract Snippet
    if content and content.strip():
        print(f"{GRAY}────────────────────────────────────────────────────────────{RESET}")
        print(f"{BLUE}{BOLD}EXTRACTED TEXT PREVIEW{RESET}")
        snippet_lines = content.strip().splitlines()[:14]
        for line in snippet_lines:
            print(f"  {DIM}{line[:90]}{RESET}")
        if len(content.strip().splitlines()) > 14:
            print(f"  {DIM}... ({len(content.strip().splitlines()) - 14} more lines){RESET}")
        print()

    # Keyboard Controls Footnote
    print(f"{GRAY}────────────────────────────────────────────────────────────{RESET}")
    print(f"  {GREEN}[Enter]{RESET} Open File   {CYAN}[Ctrl+Y/C]{RESET} Copy Path   {YELLOW}[Ctrl+D]{RESET} Copy Drive URL")
    print(f"  {MAGENTA}[Ctrl+S]{RESET} Copy Summary   {BLUE}[Ctrl+O]{RESET} Open in Drive   {WHITE}[Ctrl+E]{RESET} Open Folder")

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--sync":
        sync_local_files()
        print(f"Synced {len(list(FILES_DIR.glob('*')))} files to {FILES_DIR}")
        return

    # If called with --preview <id>, just render preview and exit
    if len(sys.argv) >= 3 and sys.argv[1] == "--preview":
        render_preview(sys.argv[2])
        return

    # Ensure files are synced
    sync_local_files()

    if not DB_PATH.exists():
        print(f"Error: Reyna database not found at {DB_PATH}", file=sys.stderr)
        sys.exit(1)

    if not shutil.which("fzf"):
        print("Error: fzf is required for interactive search. Install with 'sudo apt install fzf'", file=sys.stderr)
        sys.exit(1)

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT id, file_name, subject, shared_by_name, file_size, drive_file_id, created_at, content_summary
        FROM files
        ORDER BY id DESC
    """)
    rows = c.fetchall()
    conn.close()

    if not rows:
        print("No documents found in Reyna yet. Send documents to your WhatsApp group to begin capture.")
        sys.exit(0)

    # Format items for FZF
    # TSV format: id \t subject \t filename \t size \t sender \t date \t drive_status
    lines = []
    for r in rows:
        fid, name, subject, sender, size, drive_id, created, summary = r
        sub_badge = f"[{subject}]" if subject else "[Uncategorized]"
        size_str = format_size(size)
        sender_str = f"by {sender}" if sender else ""
        date_str = str(created).split()[0] if created else ""
        cloud_icon = "☁️ drive" if (drive_id and not drive_id.startswith("local_")) else "💾 local"
        line = f"{fid}\t{sub_badge:<16}\t{name:<36}\t{size_str:<9}\t{sender_str:<18}\t{date_str:<10}\t{cloud_icon}"
        lines.append(line)

    fzf_input = "\n".join(lines)

    header = (
        "⚡ reyacast: instant whatsapp document retrieval\n"
        "[Enter] Open  [Ctrl+Y/C] Copy Path  [Ctrl+D] Copy Drive URL  [Ctrl+S] Copy Summary  [Ctrl+O] Open Drive"
    )

    fzf_cmd = [
        "fzf",
        "--ansi",
        "--delimiter=\t",
        "--with-nth=2,3,4,5,6,7",
        f"--preview={sys.argv[0]} --preview {{1}}",
        "--preview-window=right:56%:wrap",
        f"--header={header}",
        "--prompt=⚡ reyna-find > ",
        "--pointer=▶",
        "--marker=✔",
        "--color=header:italic:green,prompt:bold:green,pointer:bold:green,preview-bg:#0d1117,border:#30363d",
        "--border=rounded",
        "--expect=ctrl-y,ctrl-c,ctrl-d,ctrl-s,ctrl-o,ctrl-e,enter",
    ]

    try:
        proc = subprocess.Popen(fzf_cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
        stdout, _ = proc.communicate(input=fzf_input)
    except Exception as e:
        print(f"Error running fzf: {e}", file=sys.stderr)
        sys.exit(1)

    if proc.returncode != 0 or not stdout.strip():
        # User pressed Escape or Ctrl-C in fzf
        sys.exit(0)

    parts = stdout.splitlines()
    if not parts:
        sys.exit(0)

    key = parts[0].strip().lower()
    selected_line = parts[1] if len(parts) > 1 else ""

    if not selected_line:
        sys.exit(0)

    file_id_str = selected_line.split("\t")[0].strip()
    if not file_id_str.isdigit():
        sys.exit(0)

    file_id = int(file_id_str)

    # Fetch file details for action
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT file_name, subject, drive_file_id, content_summary FROM files WHERE id = ?", (file_id,))
    file_info = c.fetchone()
    conn.close()

    if not file_info:
        sys.exit(0)

    file_name, subject, drive_id, summary = file_info
    local_path = FILES_DIR / file_name
    win_path = get_windows_path(local_path)
    drive_url = f"https://drive.google.com/file/d/{drive_id}/view" if (drive_id and not drive_id.startswith("local_")) else ""

    # Actions:
    if key in ["ctrl-y", "ctrl-c"]:
        copy_to_clipboard(win_path)
        print(f"{GREEN}✓ Copied Windows file path to clipboard:{RESET}")
        print(f"  {WHITE}{win_path}{RESET}")
        print(f"{GRAY}  Tip: You can now press Ctrl+V directly into any Windows file picker, email, or chat!{RESET}")

    elif key == "ctrl-d":
        if drive_url:
            copy_to_clipboard(drive_url)
            print(f"{GREEN}✓ Copied Google Drive link to clipboard:{RESET}")
            print(f"  {CYAN}{drive_url}{RESET}")
        else:
            print(f"{YELLOW}File has not been synced to Google Drive yet (saved locally).{RESET}")

    elif key == "ctrl-s":
        if summary:
            copy_to_clipboard(summary)
            print(f"{GREEN}✓ Copied AI summary to clipboard!{RESET}")
        else:
            print(f"{YELLOW}No AI summary available for this file.{RESET}")

    elif key == "ctrl-o":
        if drive_url:
            print(f"{CYAN}↗ Opening in Google Drive...{RESET}")
            subprocess.run(["explorer.exe", drive_url])
        else:
            print(f"{YELLOW}File has not been synced to Google Drive yet.{RESET}")

    elif key == "ctrl-e":
        folder_win_path = get_windows_path(FILES_DIR)
        print(f"{CYAN}↗ Opening folder in Windows Explorer...{RESET}")
        subprocess.run(["explorer.exe", folder_win_path])

    else:
        # Default Enter key: Open file in default Windows viewer AND copy path
        copy_to_clipboard(win_path)
        print(f"{GREEN}✓ Copied path to clipboard and opening file:{RESET}")
        print(f"  {WHITE}{file_name}{RESET}")
        subprocess.run(["explorer.exe", win_path])

if __name__ == "__main__":
    main()
